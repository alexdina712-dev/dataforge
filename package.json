    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.2",
    "vite": "^6.3.6",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22 <25"
